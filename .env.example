# ==============================================================================
# NetTask Environment Variables Configuration Example
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# PostgreSQL Database (Supabase)
# NOTE: In Supabase connection pooler, the username must include your project tenant reference:
# e.g., postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database (Used by Prisma for migrations and search vector sync)
DIRECT_URL="postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL="https://yourprojectref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Vercel Cron Security Secret (Bearer token for /api/cron/* routes)
CRON_SECRET="your-generated-cron-secret-token"

# Telegram Bot Notification Alerts (Optional - logs to console if empty)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_CHAT_ID="-1001234567890"

# Application Timezone & Port
TZ="Asia/Bangkok"
PORT=3000

