generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum DeviceRole {
  Core
  Distribution
  Access
  Firewall
  AP
  Router
  UPS
  Other
}

enum DeviceStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum TaskType {
  TASK
  INCIDENT
  CHANGE
  MAINTENANCE
  AUDIT
}

enum TaskPriority {
  P1
  P2
  P3
  P4
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum CaseCategory {
  CONNECTIVITY
  PERFORMANCE
  HARDWARE
  CONFIGURATION
  SECURITY
  WIRELESS
  ISP
  POWER
  OTHER
}

enum CaseSeverity {
  P1
  P2
  P3
  P4
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  role      UserRole  @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tasks     Task[]
  auditLogs AuditLog[]

  @@map("users")
}

model Site {
  id            String    @id @default(uuid())
  name          String
  location      String?
  contactPerson String?
  phone         String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  devices       Device[]
  tasks         Task[]
  cases         Case[]

  @@map("sites")
}

model Device {
  id           String       @id @default(uuid())
  hostname     String       @unique
  ipAddress    String
  vendor       String
  model        String
  serialNumber String?
  role         DeviceRole   @default(Other)
  status       DeviceStatus @default(ACTIVE)
  purchaseDate DateTime?
  warrantyEnd  DateTime?
  licenseEnd   DateTime?
  notes        String?
  siteId       String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  tasks        Task[]
  cases        Case[]

  @@index([siteId])
  @@index([role])
  @@index([status])
  @@map("devices")
}

model Task {
  id           String       @id @default(uuid())
  title        String
  description  String?
  type         TaskType     @default(TASK)
  priority     TaskPriority @default(P3)
  status       TaskStatus   @default(TODO)
  dueDate      DateTime?
  startAt      DateTime?
  endAt        DateTime?
  completedAt  DateTime?
  siteId       String?
  deviceId     String?
  assigneeId   String?
  ticketRef    String?
  rollbackPlan String?
  recurrence   String?
  parentId     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  assignee     User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  parent       Task?        @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: SetNull)
  children     Task[]       @relation("TaskSubtasks")

  checklists   Checklist[]
  notes        Note[]
  cases        Case[]

  @@index([status, dueDate])
  @@index([assigneeId, status])
  @@index([deviceId])
  @@index([siteId])
  @@map("tasks")
}

model Checklist {
  id        String   @id @default(uuid())
  taskId    String
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("checklists")
}

model Note {
  id        String   @id @default(uuid())
  taskId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("notes")
}

model Case {
  id              String       @id @default(uuid())
  caseNumber      String       @unique
  title           String
  symptom         String
  cause           String?
  solution        String
  prevention      String?
  category        CaseCategory @default(CONNECTIVITY)
  severity        CaseSeverity @default(P3)
  vendor          String?
  tags            String[]     @default([])
  siteId          String?
  deviceId        String?
  taskId          String?
  timeToFix       Int?         // in minutes
  occurredAt      DateTime     @default(now())
  resolvedAt      DateTime?
  viewCount       Int          @default(0)
  recurrenceCount Int          @default(1)
  isFavorite      Boolean      @default(false)
  isPinned        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  site            Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  device          Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  task            Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  attachments     Attachment[]

  @@index([category, occurredAt])
  @@index([tags], type: Gin)
  @@index([siteId])
  @@index([deviceId])
  @@map("cases")
}

model Attachment {
  id        String   @id @default(uuid())
  caseId    String
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int      // in bytes
  createdAt DateTime @default(now())

  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("attachments")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  tableName String
  recordId  String
  userId    String?
  meta      Json?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tableName, recordId])
  @@index([userId])
  @@map("audit_logs")
}
